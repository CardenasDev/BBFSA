# ============================================================
# BBFSA - Git Ignore Root
# Laravel Backend + Angular Frontend
# Ubicación esperada: BBFSA/.gitignore
# ============================================================


# ------------------------------------------------------------
# OS / Editor
# ------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

.idea/

*.swp
*.swo


# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.local


# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

logs/


# ------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------

node_modules/
Front/node_modules/
Back/node_modules/

vendor/
Back/vendor/


# ------------------------------------------------------------
# Angular / Frontend Build
# ------------------------------------------------------------

dist/
Front/dist/

.angular/
Front/.angular/

.cache/
Front/.cache/

coverage/
Front/coverage/

.nx/
Front/.nx/

out-tsc/
Front/out-tsc/


# ------------------------------------------------------------
# Angular / TypeScript Misc
# ------------------------------------------------------------

*.tsbuildinfo
Front/*.tsbuildinfo


# ------------------------------------------------------------
# Laravel / PHP Backend
# ------------------------------------------------------------

# Laravel application keys
Back/storage/*.key


# ------------------------------------------------------------
# Laravel Storage
#
# Los archivos cargados/generados por usuarios NO deben
# versionarse en Git.
# ------------------------------------------------------------

Back/storage/app/*
!Back/storage/app/.gitignore

Back/storage/framework/cache/*
!Back/storage/framework/cache/.gitignore

Back/storage/framework/sessions/*
!Back/storage/framework/sessions/.gitignore

Back/storage/framework/testing/*
!Back/storage/framework/testing/.gitignore

Back/storage/framework/views/*
!Back/storage/framework/views/.gitignore

Back/storage/logs/*
!Back/storage/logs/.gitignore


# ------------------------------------------------------------
# Laravel Generated Files
# ------------------------------------------------------------

Back/bootstrap/cache/*.php
Back/bootstrap/cache/*.log

Back/public/storage
Back/public/hot

Back/.phpunit.result.cache
.phpunit.result.cache


# ------------------------------------------------------------
# Composer / PHP Tooling Cache
# ------------------------------------------------------------

.composer/

.php-cs-fixer.cache

.phpunit.cache/
Back/.phpunit.cache/


# ------------------------------------------------------------
# Tests / Reports
# ------------------------------------------------------------

coverage-html/
reports/
test-results/


# ------------------------------------------------------------
# Temporary Files
# ------------------------------------------------------------

tmp/
temp/

*.tmp
*.bak
*.backup


# ------------------------------------------------------------
# BMAD / AI Agents
#
# Herramientas utilizadas localmente para análisis y
# documentación. No forman parte del código de BBFSA.
# ------------------------------------------------------------

.agents/
_bmad/


# ------------------------------------------------------------
# Temporary PDF Review / Rendering
# ------------------------------------------------------------

.tmp-pdf-review/


# ------------------------------------------------------------
# Generated Output
#
# PDFs y otros artefactos generados durante pruebas o
# documentación.
# ------------------------------------------------------------

output/


# ------------------------------------------------------------
# QA / Local Backups
#
# Carpeta utilizada para copias/artefactos locales de QA.
# No forma parte del código fuente.
# ------------------------------------------------------------

QA/


# ------------------------------------------------------------
# Compressed Files / Backups
# ------------------------------------------------------------

*.zip
*.rar
*.7z


# ------------------------------------------------------------
# Temporary Generation Scripts
# ------------------------------------------------------------

Front/tmp-*.js
Back/tmp-*.php


# ------------------------------------------------------------
# Nested Git Repositories Created By Mistake
#
# El repositorio Git debe existir únicamente en la raíz BBFSA.
# ------------------------------------------------------------

Front/.git/
Back/.git/


# ------------------------------------------------------------
# Nested .gitignore
#
# Se utiliza únicamente el .gitignore raíz del proyecto.
# ------------------------------------------------------------

Front/.gitignore
Back/.gitignore